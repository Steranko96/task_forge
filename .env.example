# Local development template only. Copy to ignored .env, then fill the blank key.
# Django does not load this file automatically; see README for shell export.
DJANGO_ENV=development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_ENGINE=sqlite3
DB_NAME=
# PostgreSQL fields: fill only when configuring PostgreSQL (TSK-006).
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
